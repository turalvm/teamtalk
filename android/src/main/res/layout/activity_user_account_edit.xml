<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabGravity="fill"
        app:tabMode="fixed">

        <com.google.android.material.tabs.TabItem
            android:id="@+id/tab_item_basic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_basic_info" />

        <com.google.android.material.tabs.TabItem
            android:id="@+id/tab_item_rights"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_user_rights" />
    </com.google.android.material.tabs.TabLayout>

    <FrameLayout
        android:id="@+id/container_tabs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Basic Information Tab -->
        <ScrollView
            android:id="@+id/layout_tab_basic"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:labelFor="@+id/edit_username"
                    android:text="@string/label_username"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edit_username"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="@string/hint_username"
                    android:inputType="textNoSuggestions|textVisiblePassword"
                    android:minHeight="48dp"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:labelFor="@+id/edit_password"
                    android:text="@string/label_password"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edit_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="@string/hint_password"
                    android:inputType="textVisiblePassword"
                    android:minHeight="48dp"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:labelFor="@+id/edit_note"
                    android:text="@string/label_note"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edit_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="@string/hint_note"
                    android:inputType="textMultiLine"
                    android:minLines="2" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:labelFor="@+id/spinner_init_channel"
                    android:text="@string/label_initial_channel"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinner_init_channel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:minHeight="48dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/label_user_type"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/radiogroup_user_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/radio_type_default"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:minHeight="48dp"
                        android:text="@string/user_type_default" />

                    <RadioButton
                        android:id="@+id/radio_type_admin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/user_type_admin" />

                    <RadioButton
                        android:id="@+id/radio_type_none"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/user_type_none" />
                </RadioGroup>
            </LinearLayout>
        </ScrollView>

        <!-- User Rights Tab -->
        <ScrollView
            android:id="@+id/layout_tab_rights"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <CheckBox
                    android:id="@+id/check_right_change_nickname"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/right_change_nickname" />

                <CheckBox
                    android:id="@+id/check_right_multi_login"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/right_multi_login" />

                <CheckBox
                    android:id="@+id/check_right_view_all_users"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/right_view_all_users" />

                <CheckBox
                    android:id="@+id/check_right_view_hidden_channels"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/right_view_hidden_channels" />

                <CheckBox
                    android:id="@+id/check_right_modify_channels"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/right_modify_channels" />

                <CheckBox
                    android:id="@+id/check_right_create_temp_channel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/right_create_temp_channel" />

                <CheckBox
                    android:id="@+id/check_right_update_server_properties"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/right_update_server_properties" />

                <CheckBox
                    android:id="@+id/check_right_kick_users"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/right_kick_users" />

                <CheckBox
                    android:id="@+id/check_right_ban_users"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/right_ban_users" />

                <CheckBox
                    android:id="@+id/check_right_move_users"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/right_move_users" />

                <CheckBox
                    android:id="@+id/check_right_operator_enable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/right_operator_enable" />

                <CheckBox
                    android:id="@+id/check_right_upload_files"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/right_upload_files" />

                <CheckBox
                    android:id="@+id/check_right_download_files"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/right_download_files" />

                <CheckBox
                    android:id="@+id/check_right_record_voice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/right_record_voice" />

                <CheckBox
                    android:id="@+id/check_right_transmit_voice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/right_transmit_voice" />

                <CheckBox
                    android:id="@+id/check_right_transmit_videocapture"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/right_transmit_videocapture" />

                <CheckBox
                    android:id="@+id/check_right_transmit_desktop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/right_transmit_desktop" />

                <CheckBox
                    android:id="@+id/check_right_transmit_desktopinput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/right_transmit_desktopinput" />

                <CheckBox
                    android:id="@+id/check_right_transmit_mediafile_audio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/right_transmit_mediafile_audio" />

                <CheckBox
                    android:id="@+id/check_right_transmit_mediafile_video"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/right_transmit_mediafile_video" />

                <CheckBox
                    android:id="@+id/check_right_textmessage_user"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/right_textmessage_user" />

                <CheckBox
                    android:id="@+id/check_right_textmessage_channel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/right_textmessage_channel" />

                <CheckBox
                    android:id="@+id/check_right_textmessage_broadcast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/right_textmessage_broadcast" />

            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Bottom Action Bar -->
    <LinearLayout
        android:id="@+id/layout_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/btn_delete_account"
            style="?android:attr/buttonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:minHeight="48dp"
            android:text="@string/btn_delete_account" />

        <Button
            android:id="@+id/btn_cancel_account"
            style="?android:attr/buttonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:minHeight="48dp"
            android:text="@string/btn_cancel" />

        <Button
            android:id="@+id/btn_save_account"
            style="?android:attr/buttonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:minHeight="48dp"
            android:text="@string/btn_save_account" />
    </LinearLayout>

</LinearLayout>
